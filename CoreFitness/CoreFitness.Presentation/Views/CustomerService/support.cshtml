@using CoreFitness.Presentation.Models.CustomerService
@model CustomerServiceViewModel
@{
    ViewData["Title"] = "Customer Service";
}

<div class="customerservice-container">

    <partial name="Partials/_PageTitleSection" />

    <section class="customerservice-section">
        <!-- Customer Service image side -->
        <div class="customer-image">
            <img class="customer-woman" src="~/images/contact-us-image.svg" alt="Gym woman" />
            <div class="service-information">
                <div class="phone-side">
                    <div class="icon-circle">
                        <img class="support-phone" src="~/images/phone-icon.svg" alt="" />
                    </div>
                    <div class="phone-number">
                        <p class="icon-text">Phone Number</p>
                        <p>+(46) 8 410 521 00</p>
                    </div>
                </div>
                <div class="email-side">
                    <div class="icon-circle">
                    <img class="support-mail" src="~/images/mail-icon.svg" alt="" />
                    </div>
                    <div class="email-address">
                        <p class="icon-text">Email Address</p>
                        <p>info@corefitness.se</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Customer Service form side -->
        <div class="customer-card">
            <div class="contact-us-body">
                <div class="contact-title">
                    <h2>Contact Us Today</h2>
                    <h3>Ready to begin your fitness journey? Contact GymPro today and let our expert trainers guide you with the right program and support.</h3>
                </div>
                <div class="contact-forms">
                    @if (TempData["Success"] != null)
                    {
                        <p class="success-message">@TempData["Success"]</p>
                    }
                    <form method="post" asp-controller="CustomerService" asp-action="Support" novalidate>
                        @Html.AntiForgeryToken()

                        <div class="contact-us-firstname">
                            <div class="form-group">
                                <label class="form-label" asp-for="FormData.FirstName"></label>
                                <input class="form-control" asp-for="FormData.FirstName" />
                                <span class="field-validation-error" asp-validation-for="FormData.FirstName"></span>
                            </div>
                        </div>
                        <div class="contact-us-lastname">
                            <div class="form-group">
                                <label class="form-label" asp-for="FormData.LastName"></label>
                                <input class="form-control" asp-for="FormData.LastName" />
                                <span class="field-validation-error" asp-validation-for="FormData.LastName"></span>
                            </div>
                        </div>
                        <div class="contact-us-email">
                            <div class="form-group">
                                <label class="form-label" asp-for="FormData.Email"></label>
                                <input class="form-control" asp-for="FormData.Email" />
                                <span class="field-validation-error" asp-validation-for="FormData.Email"></span>
                            </div>
                        </div>
                        <div class="contact-us-phonenumber">
                            <div class="form-group">
                                <label class="form-label" asp-for="FormData.PhoneNumber"></label>
                                <input class="form-control" asp-for="FormData.PhoneNumber" />
                                <span asp-validation-for="FormData.PhoneNumber"></span>
                            </div>
                        </div>
                        <div class="contact-us-message">
                            <div class="form-group">
                                <label class="form-label" asp-for="FormData.Message"></label>
                                <textarea class="form-control" asp-for="FormData.Message"></textarea>
                                <span class="field-validation-error" asp-validation-for="FormData.Message"></span>
                            </div>
                        </div>

                        <button class="btn" type="submit">Submit Message<img src="~/images/arrow-right.svg" alt="arrow-right" /></button>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <!-- Faqs section -->
    <partial name="Partials/_FaqSection" model="Model.Faqs" />
</div>
@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.faq-question').forEach(button => {
                button.addEventListener('click', () => {
                    const faqItem = button.parentElement;
                    const isActive = faqItem.classList.contains('active');

                    document.querySelectorAll('.faq-item').forEach(item => item.classList.remove('active'));

                    if (!isActive) {
                        faqItem.classList.add('active');
                    }
                });
            });
        });
    </script>
}
