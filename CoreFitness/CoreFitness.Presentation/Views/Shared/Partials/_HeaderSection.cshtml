@using CoreFitness.Presentation.Models
<section class="header-section">
    <div class="header-container">
        <!--- Logo --->
        <a asp-controller="Home" asp-action="Index" class="header-logo">
            <img src="~/images/logotype.svg" alt="CoreFitness Club" /> 
            
        </a>

        <!--- Navbar --->
        <nav class="main-menu">
            <ul class="menu">
                <li class="menu-item"><a asp-controller="FitnessCenters" asp-action="Index">Fitness Centers</a></li>
                <li class="menu-item"><a asp-controller="Memberships" asp-action="Index">Memberships</a></li>
                <li class="menu-item dropdown">
                    <a class="menu-training" asp-controller="Training" asp-action="Index">Training</a>
                    <ul class="dropdown-menu">
                        <li><a class="menu-training" asp-controller="Training" asp-action="Index">Personal Training</a></li>
                        <li><a class="menu-training" asp-controller="Training" asp-action="Index">Group Training</a></li>
                    </ul>
                </li>
                <li class="menu-item"><a asp-controller="CustomerService" asp-action="Support">Customer Service</a></li>
                <li class="menu-item"><a asp-controller="Store" asp-action="Index">Store</a></li>
            </ul>
        </nav>

        <!--- Auth ---> 

        <div class="header-actions">
            @if (User.Identity?.IsAuthenticated ?? false)
            {
                <a asp-controller="Training" asp-action="Index" class="header-link">Our Classes</a>
                <partial name="Partials/_Button" model='new ButtonModel { Text = "My Account", Controller = "Account", Action = "My" }' />
            }
            else
            {
                <a asp-controller="Authentication" asp-action="SignUp" class="header-link">Become Member</a>
                <partial name="Partials/_Button" model='new ButtonModel { Text = "Sign In", Controller = "Authentication", Action = "SignIn" }' />
            }
        </div>
    </div>
</section>