@section Hero {
    <partial name="Partials/_HeroSection" />
}
<!-- Brands section -->
<div class="brands-container">
    <section class="brands-items">
        <div class="brands">
            <img src="~/images/company-logo1.svg" alt="company1" />
            <img src="~/images/company-logo2.svg" alt="company2" />
            <img src="~/images/company-logo3.svg" alt="company3" />
            <img src="~/images/company-logo4.svg" alt="company4" />
            <img src="~/images/company-logo5.svg" alt="company5" />
        </div>
        <h2 class="brands-text">Modern Equipment</h2>
    </section>
</div>

<!-- About Us section -->
<section class="about-us-section">

    <!-- About Us section: Photo side -->
    <div class="about-us-container">
        <div class="about-us-gym">
            <img class="photo-gym" src="~/images/aboutus-gym.svg" alt="gym" />
        </div>

        <!-- About Us section: Text side -->
        <div class="about-us-texts">
            <div class="about-us-items">
                <h2><span class="dot">•</span>About Us</h2>

                <h3>Elevating Fitness Journey with Expert Guidance</h3>

                <p class="description">We support every stage of your fitness journey with certified trainers, personalized programs proven methods designed to help you train safely, build strength.</p>
            </div>
            <div class="aboutus-text-box">
                <p class="box-text">Our mission is to transform lives by combining expert guidance, powerful training programs, and a motivating community that helps you grow stronger every day.</p>
                <img class="quote-icon" src="~/images/about-quote.svg" alt="" />
            </div>
        </div>
　　</div>
</section>