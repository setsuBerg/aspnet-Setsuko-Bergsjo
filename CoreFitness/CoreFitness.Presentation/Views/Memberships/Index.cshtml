@using CoreFitness.Presentation.Models
@model MembershipViewModel

@{
    ViewData["Title"] = "Our Membership Offers";
}

<div class="memberships-container">

    <!-- Membership cards section -->
    <partial name="Partials/_PageTitleSection" />
    <section class="membership-section">
        <div class="membership-access">

            @foreach (var item in Model.Memberships)
            {
                <div class="membership-cards">
                    <div class="dumbbel-icon">
                        <img  src="~/images/dumbbell.svg" alt="" />
                    </div>
                    <h3>@item.Title</h3>
                    <hr />
                    <p class="card-description">@item.Description</p>

                    <ul>
                        @foreach (var benefit in item.Benefits)
                        {
                            <li><img src="~/images/check-icon.svg" alt="" />@benefit</li>
                        }
                    </ul>
                    <div class="membership-price-box">
                        <div class="membership-price">
                            <div class="membership-monthly">
                                <div class="monthly-price">
                                    <p class="price">@item.Price</p>
                                    <p class="per">/monthly</p>
                                </div>
                                <p class="classes">* Monthly @item.MonthlyClasses Classes</p>
                            </div>

                            <partial name="Partials/_Button" model='new ButtonModel { Text = "Join Now", Controller = "Authentication", Action = "SignUp" }' />
                        </div>
                        <hr />

                        <p>Try Any Membership Fre for 1 Week</p>
                    </div>
                </div>
            }

            <div class="membership-card">
                <h3>Get Your Membership</h3>
                <p class="description">Our memberships give you access to all equipment, personalized training.</p>
                <hr />
                <p class="membership-telephone">Call Us At: +(46) 8 410 521 00</p>
                <div class="membership-call-button">
                    <partial name="Partials/_Button" model='new ButtonModel { Text = "Call Us Today!", Controller = "CustomerService", Action = "Support" }' />
                </div>
                <img class="membership-woman" src="~/images/membership-woman.svg" alt="" />
            </div>
        </div>

        <ul class="membership-subitems">
            <li class="membership-subitem"><img src="~/images/memberships-icon1.svg" alt="" />Get 30 day free trial</li>
            <li class="membership-subitem"><img src="~/images/memberships-icon2.svg" alt="" />No any hidden fees pay</li>
            <li class="membership-subitem"><img src="~/images/memberships-icon3.svg" alt="" />You can cancel anytime</li>
        </ul>
    </section>

    <!-- Faqs section -->
    <partial name="Partials/_FaqSection" model="Model.Faqs" />
</div>
@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.faq-question').forEach(button => {
                button.addEventListener('click', () => {
                    const faqItem = button.parentElement;
                    const isActive = faqItem.classList.contains('active');

                    document.querySelectorAll('.faq-item').forEach(item => item.classList.remove('active'));

                    if (!isActive) {
                        faqItem.classList.add('active'); 
                    }
                });
            });
        });
    </script>
}